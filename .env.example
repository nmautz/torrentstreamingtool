# ── Jackett (P2P Indexer) ─────────────────────────────────────────────────────
# Jackett Web UI → API Key (top-right corner after logging in). REQUIRED — until
# this is set, every search returns "Indexer unreachable".
INDEXER_URL=http://localhost:9117
INDEXER_API_KEY=your_jackett_api_key_here
# 0=all categories | 2000=Movies | 5000=TV | 3000=Audio
INDEXER_CATEGORIES=0
# Jackett admin password (only if you set one on the Jackett dashboard). Lets the
# admin panel manage indexers on your behalf. Leave blank if Jackett has no password.
JACKETT_PASSWORD=

# ── TMDb metadata (optional but recommended) ──────────────────────────────────
# Free key from https://www.themoviedb.org/settings/api — powers posters, the
# Explore tab, and episode names. Without it, search still works but falls back to
# plain text results. Can also be set live in Admin → Indexers → TMDb Metadata.
TMDB_API_KEY=

# ── FlareSolverr (optional) ───────────────────────────────────────────────────
# Only needed for Cloudflare-protected indexers. StreamLink can install & run it
# from the admin panel (Indexers → FlareSolverr); this is just the URL it lives at.
FLARESOLVERR_URL=http://localhost:8191

# ── qBittorrent ───────────────────────────────────────────────────────────────
# Tools → Preferences → Web UI  (set port to 8081 to avoid VLC conflict)
QBIT_URL=http://localhost:8081
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin
# Absolute path where torrents will be saved (created automatically)
QBIT_DOWNLOAD_PATH=/Users/yourname/Downloads/StreamLink

# ── VLC ───────────────────────────────────────────────────────────────────────
# VLC → Preferences → Show All → Interface → Main interfaces → check "Web"
# Set Lua HTTP password under Interface → Main interfaces → Lua
# Port stays at 8080 (VLC default)
VLC_URL=http://localhost:8080
VLC_PASSWORD=vlcpassword

# ── Admin panel ───────────────────────────────────────────────────────────────
# Password for the /admin settings panel. If blank, the admin panel is DISABLED
# entirely. Change this from the default before anyone else can reach the host.
ADMIN_PASSWORD=changeme
# iOS client pairing (optional). When true, the app's sync + download endpoints
# reject unpaired devices (pair once with ADMIN_PASSWORD). The browser dashboard
# and online playback are unaffected either way. Leave false on a home LAN.
REQUIRE_DEVICE_AUTH=false

# ── Buffer thresholds ─────────────────────────────────────────────────────────
# Stream to VLC once either threshold is crossed (whichever comes first)
BUFFER_MIN_MB=15.0
BUFFER_MIN_PCT=1.0

# ── Windows admin credentials (optional, Windows only) ────────────────────────
# Used for elevated host tweaks — currently disabling the physical power/sleep
# buttons (powercfg needs admin rights). Not needed if `run.py --install` ran
# elevated (it applies the tweak then). Can also be set from the admin panel
# (Updates tab → feature keys). Stored only in this host's .env.
#WINDOWS_ADMIN_USER=Administrator
#WINDOWS_ADMIN_PASSWORD=your_windows_admin_password

# ── Wireless remote (air-mouse) + TV UI ───────────────────────────────────────
# Input listener for HID wireless remotes plugged into this host
# (play/pause, volume, skip, Home). 1 = on (default), 0 = off. See docs/REMOTE.md
REMOTE_CONTROL=1
# Firestick-style dashboard kiosk on the TV: any remote button wakes the web UI,
# idle hands the screen back to the background video, Home stops playback and
# opens it. Needs REMOTE_CONTROL=1 for the wake signal.
TV_UI=1
TV_UI_IDLE_SECS=120
# Advanced: OS-mixer volume watchdog. Leave 0 unless the remote's volume keys
# change the WINDOWS system volume even while StreamLink is running (a remote
# whose volume bypasses the keyboard hook). See docs/REMOTE.md.
REMOTE_VOLUME_GUARD=0
